# ==============================================================================
# .gitignore - Protección de seguridad y buenas prácticas para Django & Python
# ==============================================================================

# Entornos Virtuales (Virtual Environments)
myvenv/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Variables de entorno, Credenciales, Claves y Tokens de Seguridad
.env
.env.*
*.env
!.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
secrets.json
credentials.json
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.token
*token*.json
*secret*.json
api_key*
client_secret*.json

# Bases de Datos Locales (Protección de datos personales y estado local)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
db.sqlite3

# Byte-compiled / optimizados / temporales de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Archivos de Logs
*.log
local_settings.py
db.sqlite3-journal

# Archivos multimedia subidos por usuarios (Media)
media/
mediafiles/

# IDEs, Editores y Entornos de Desarrollo
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Archivos de Sistema Operativo (Windows & macOS)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
Icon

# Archivos de pruebas y cobertura
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
